[Unit]
Description=claude check-in: end-of-day review, same-day backtest diff, next-session tuning (13:30 PT)
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/dylmet/Projects/galactic_trading_firm
EnvironmentFile=/home/dylmet/Projects/galactic_trading_firm/.env
Environment=PATH=/home/dylmet/.local/bin:/home/dylmet/.cargo/bin:/usr/local/bin:/usr/bin:/bin
Environment=TZ=America/Los_Angeles
# headless: no TTY, no approvals possible. tools are pre-approved in .claude/settings.json;
# anything else is denied rather than waited on.
ExecStart=/bin/sh -c 'mkdir -p logs/checkins && /home/dylmet/.local/bin/claude -p "/eod-review" --model opus --output-format json --max-turns 80 --max-budget-usd 5.00 --permission-mode dontAsk --permission-prompts none >> logs/checkins/eod-review.jsonl'
TimeoutStartSec=900
